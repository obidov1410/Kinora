# Kinora backend environment example.
# Copy to .env for local use, or configure the same keys in Render.
# Never commit real secrets. BOT_TOKEN must exist only on the server.

ENV=production
BOT_TOKEN=
BOT_USERNAME=KinoraTV_bot
OWNER_ID=7041471070
SECRET_KEY=

DATABASE_URL=sqlite:////var/data/kinora.db
DATA_DIR=/var/data
UPLOADS_DIR=/var/data/uploads
BACKUPS_DIR=/var/data/backups

# Exact browser origins, comma separated. Paths are not allowed.
CORS_ORIGINS=https://obidov1410.github.io
FRONTEND_URL=https://obidov1410.github.io/Kinora/

ALLOW_DEV_LOGIN=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
SESSION_TTL_HOURS=168
TELEGRAM_AUTH_MAX_AGE=86400
MEDIA_TOKEN_TTL_HOURS=6
MAX_UPLOAD_MB=8
BACKUP_INTERVAL_HOURS=0
BACKUP_RETENTION=10
SEED_DEMO=true

# "none" disables checkout (503) instead of inventing a payment provider.
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=
